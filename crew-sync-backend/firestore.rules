rules_version = '2';
// Plaid access tokens live here; no client (app/web) may read or write. Admin SDK bypasses rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /crewStashKids/{doc} { allow read, write: if false; }
    match /crewStashItems/{doc} { allow read, write: if false; }
  }
}
